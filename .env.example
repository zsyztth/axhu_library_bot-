# Library seat booking system - environment variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Your library account
LIBRARY_USERNAME=your_student_id
LIBRARY_PASSWORD=your_password

# HMAC secret key (extracted from library frontend)
HMAC_SECRET=your_hmac_secret

# Doubao / OpenAI-compatible vision API (optional - for AI captcha solving)
VISION_API_KEY=your_api_key
VISION_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VISION_API_MODEL=doubao-seed-2-0-code-preview-260215

# Webhook for notifications (Feishu / Discord / etc.)
WEBHOOK_URL=
